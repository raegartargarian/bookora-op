{
  // Deno Deploy entrypoint: deno/main.ts
  //
  // Local run:   deno task dev
  // Local tests: deno task test
  //
  // To deploy from the CLI, install deployctl (`deno install -Arf jsr:@deno/deployctl`)
  // and run:  deployctl deploy --project=<your-project> --entrypoint=main.ts
  // (or uncomment the "deploy" block below with your org/app to skip the flags).
  //
  // "deploy": { "org": "<your-org>", "app": "bookora-ai" },

  "tasks": {
    "dev": "deno run --allow-net --allow-env --watch main.ts",
    "start": "deno run --allow-net --allow-env main.ts",
    "test": "deno test --allow-env main_test.ts",
    "check": "deno check main.ts && deno lint && deno fmt --check"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
